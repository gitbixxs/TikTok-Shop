# TikTok-Shop Automation - Environment Configuration Example
# Copy this file to .env and fill in values for local script execution.
# Never commit .env to git.

# Target TikTok Account
TIKTOK_HANDLE=bizpunk72
TIKTOK_ACCOUNT_ID=7587763422331175958
ZERNIO_TIKTOK_ACCOUNT_ID=6a99599b77555aae01ce4ec4
TARGET_FOLLOWER_THRESHOLD=1500

# Baserow Configuration
BASEROW_BASE_URL=https://baserow.mafrapi.eu
BASEROW_TOKEN=your_baserow_token_here
BASEROW_DATABASE_ID=128

# FFmpeg Render Service (Coolify Microservice)
FFMPEG_BASE_URL=https://ffmpeg.mafrapi.eu

# AI Generation Providers (via Hugging Face Router / fal.ai / Replicate)
HF_TOKEN=your_huggingface_token_here
HF_IMAGE_PROVIDER=fal-ai
HF_IMAGE_MODEL=fal-ai/flux/schnell
HF_VIDEO_PROVIDER=fal-ai
HF_VIDEO_MODEL=fal-ai/wan/v2.2-5b/text-to-video
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Apify Configuration (TikTok Shop & Outlier Discovery)
APIFY_API_TOKEN=your_apify_token_here

# Zernio API (TikTok Creator Inbox Draft Publishing)
ZERNIO_API_KEY=your_zernio_api_key_here

# Telegram Notification Bot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
