    {
      "id": "72a2d496-c0c4-444f-a5d2-9c58f9f1a8d2",
      "name": "Build Reel Spec",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Quota snapshot is fetched live by the 'Fetch ZeroGPU Quota' node.\nconst quotaRaw = $('Fetch ZeroGPU Quota').first().json || {};\nconst QUOTA = { base: Number(quotaRaw.base), current: Number(quotaRaw.current), overquotaUsed: Number(quotaRaw.overquotaUsed), resetsAt: quotaRaw.resetsAt || null, observed_at: new Date().toISOString() };\n\nconst FALLBACK = {\n  product_id: '1729964288705272356',\n  pack_quantity: '1 Packung',\n  presenter_image_url: 'https://files.catbox.moe/zaisoi.png',\n  caption_de: 'Gesichtsreinigung mit integriertem Bürstenkopf — dieses Angebot von MomoTek1 wird als Reiniger mit Kurkuma beworben. Anwendung laut Händler: anfeuchten, Schaum verteilen, gründlich abspülen. Erhältlich als 1er-, 2er- oder 3er-Pack. Details im verlinkten Shop. #gesichtsreinigung #skincarede #tiktokshopde #bizpunk72',\n  scenes: [\n    {id:'hook', kind:'presenter',\n     text:'Du suchst Gesichtsreinigung mit Bürstenkopf?',\n     prompt:'The same woman from the reference image speaks naturally to the camera in the same bright room. Preserve her identity, hairstyle, clothing and facial features. Restrained, realistic articulation with modest jaw openings and relaxed lips. Subtle head movements and natural blinking. After the spoken sentence ends, she rests with her mouth gently closed. Static camera, no cuts, no new objects.',\n     video_url:'https://ffmpeg.mafrapi.eu/temp/370f1ee234d5bb6f_hook.mp4'},\n    {id:'product', kind:'images',\n     text:'Dieses Angebot von MomoTek1 zeigt eine Reinigerflasche mit integriertem Bürstenkopf. Beworben wird sie als Gesichtsreiniger mit Kurkuma.',\n     images:['https://files.catbox.moe/dx6685.png','https://files.catbox.moe/n85f6w.png'],\n     audio_url:'https://ffmpeg.mafrapi.eu/temp/7a183618e698eec2_product.wav'},\n    {id:'usage', kind:'images',\n     text:'Die Anwendung laut Händler: Gesicht anfeuchten, Reinigungsschaum sanft verteilen und anschließend gründlich abspülen.',\n     images:['https://files.catbox.moe/kbl8cd.png','https://files.catbox.moe/n85f6w.png'],\n     audio_url:'https://ffmpeg.mafrapi.eu/temp/ec1bf96907bbe3ef_usage.wav'},\n    {id:'selection', kind:'images',\n     text:'Du kannst zwischen einer, zwei oder drei Packungen wählen. Schau vor dem Kauf auf die vollständige Inhaltsstoffliste und die genaue Variante.',\n     images:['https://files.catbox.moe/i5rmyl.png','https://files.catbox.moe/dx6685.png']},\n    {id:'cta', kind:'presenter',\n     text:'Die Produktdetails findest du im verlinkten TikTok Shop.',\n     prompt:'The same woman from the reference image speaks naturally to the camera in the same bright room. Preserve her identity, hairstyle, clothing and facial features. Restrained, realistic articulation with modest jaw openings and relaxed lips. Subtle head movements and natural blinking. After the spoken sentence ends, she rests with her mouth gently closed. Static camera, no cuts, no new objects.',\n     video_url:'https://ffmpeg.mafrapi.eu/temp/bba8679e49c60215_cta.mp4'}\n  ]\n};\n\n// Queue mode: first row in tts05_presenter_queue with status='queued' wins.\nconst rows = $('Load Queue Rows').all();\nlet spec = null;\nlet queueReelKey = '';\nfor (const it of rows) {\n  const r = it.json || {};\n  if (String(r.status || '').toLowerCase() === 'queued' && r.spec_json) {\n    try { spec = JSON.parse(String(r.spec_json)); queueReelKey = String(r.reel_key || ''); break; }\n    catch (e) { throw new Error('Queue row ' + (r.reel_key || '?') + ' has invalid spec_json: ' + e.message); }\n  }\n}\nif (!spec) spec = FALLBACK;\nspec.quota = QUOTA;\nspec.reel_id = 'presenter_reel_' + spec.product_id + '_' + $execution.id;\nspec.queue_reel_key = queueReelKey;\nreturn [{json: spec}];"
      }
    },
    {
      "id": "b9fcc7d0-f623-4786-acb9-47d6b18d4ec1",
      "name": "Quota Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const spec = $input.first()?.json || {};\nconst q = spec.quota || {};\nconst ageMs = Date.now() - Date.parse(String(q.observed_at || ''));\n// tolerate operator/server clock skew up to 5min in the future; >120s stale fails\nif (!Number.isFinite(ageMs) || ageMs < -300000 || ageMs > 120000) {\n  throw new Error('Quota evidence missing or stale/future-dated - paste a fresh snapshot into Build Reel Spec (ageMs=' + ageMs + ')');\n}\nif (!(Number(q.current) >= 1200)) {\n  throw new Error('ZeroGPU quota too low for two LongCat submits (need >=1200s, got ' + q.current + ')');\n}\nif (Number(q.overquotaUsed) !== 0) {\n  throw new Error('Overquota already used - included-quota-only policy blocks submission');\n}\nreturn [{json: spec}];"
      }
    },
    {
      "id": "3602593a-88d6-4b8e-bea1-44106caa25cd",
      "name": "Collect Image Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const spec = $('Build Reel Spec').first().json;\nconst OWN_TEMP = 'https://ffmpeg.mafrapi.eu/temp/';\nconst seen = new Set();\nconst items = [];\nconst add = (u) => { if (u && !u.startsWith(OWN_TEMP) && !seen.has(u)) { seen.add(u); items.push({ json: { key: u } }); } };\nfor (const s of spec.scenes) {\n  for (const u of (s.images || [])) add(u);\n  add(s.video_url);\n  add(s.audio_url);\n}\nreturn items;"
      }
