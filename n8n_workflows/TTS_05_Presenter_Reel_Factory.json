    {
      "id": "5f0ff269-dc05-47fd-b002-5647758e25d1",
      "name": "Assemble Render Spec",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5152,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const spec = $('Build Reel Spec').first().json;\nconst imgMap = {};\ntry { for (const it of $('Attach Asset Key').all()) imgMap[it.json.key] = it.json.file_url; } catch (e) {}\nconst clips = {};\ntry { for (const it of $('Attach Clip URL').all()) clips[it.json.scene_id] = it.json.video_url; } catch (e) {}\nconst auds = {};\ntry { for (const it of $('Attach Audio URL').all()) auds[it.json.scene_id] = it.json.audio_url; } catch (e) {}\nconst staged = (u) => imgMap[u] || u;\nconst scenes = [];\nfor (const s of spec.scenes) {\n  if (s.kind === 'presenter') {\n    const v = staged(s.video_url || clips[s.id]);\n    if (!v) throw new Error('Missing presenter clip for scene ' + s.id);\n    scenes.push({ type: 'video', url: v, text: s.text, cropTo916: true });\n  } else {\n    const a = staged(s.audio_url || auds[s.id]);\n    if (!a) throw new Error('Missing narration audio for scene ' + s.id);\n    const urls = (s.images || []).map(staged);\n    scenes.push({ type: 'images', urls, audioUrl: a, text: s.text });\n  }\n}\nreturn [{ json: { scenes, reel_id: spec.reel_id, queue_reel_key: spec.queue_reel_key || '', caption_de: spec.caption_de, product_id: spec.product_id, pack_quantity: spec.pack_quantity } }];"
      }
    },
