    {
      "id": "7b35b807-bbce-447d-96b5-1826b0a98a79",
      "name": "Parse LongCat Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4256,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const scene = $('Build LongCat Payloads').item.json.scene;\nconst raw = $input.item.json;\nconst body = String((raw && raw.data) ? raw.data : (typeof raw === 'string' ? raw : ($input.item.body || '')));\nlet url = '';\nlet ev = '';\nfor (const rawLine of body.split('\\n')) {\n  const line = rawLine.trimEnd();\n  if (line.startsWith('event:')) ev = line.slice(6).trim();\n  else if (line.startsWith('data:') && ev === 'complete') {\n    const d = JSON.parse(line.slice(5).trim());\n    const v = (d[0] && (d[0].video || d[0])) || {};\n    url = v.url || ('https://bizpunk-tiktok-longcat-worker.hf.space/gradio_api/file=' + (v.path || ''));\n  } else if (line.startsWith('data:') && ev === 'error') {\n    throw new Error('LongCat provider rejected the job for scene ' + scene.id + ' - no automatic retry');\n  }\n}\nif (!url.startsWith('https://bizpunk-tiktok-longcat-worker.hf.space/gradio_api/file=/tmp/gradio/') || !url.endsWith('.mp4')) {\n  throw new Error('LongCat result missing/invalid for scene ' + scene.id + ' - do not resubmit without checking job state');\n}\nreturn { json: { scene, hf_clip_url: url } };"
      }
    },
