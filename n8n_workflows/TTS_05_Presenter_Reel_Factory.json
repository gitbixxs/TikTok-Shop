    {
      "id": "691db88c-12a5-4d8f-8e69-2ebb55fa6041",
      "name": "Generate TTS Segments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const spec = $('Build Reel Spec').first().json;\nconst HF_AUTH = { Authorization: 'Bearer ' + ($env.HF_TOKEN || '') };\nconst sp = 'resembleai-chatterbox-multilingual-tts.hf.space';\nconst T = (p, ms) => Promise.race([p, new Promise(r => setTimeout(() => r(null), ms))]);\n\nlet refFileObj = null;\ntry {\n  const upResp = $('Upload Luisa Ref To HF').first().json;\n  let upPath = null;\n  if (typeof upResp === 'string') {\n    upPath = upResp.trim();\n  } else {\n    const upArr = typeof upResp === 'string' ? JSON.parse(upResp) : upResp;\n    upPath = Array.isArray(upArr) ? upArr[0] : (upArr && upArr.files && upArr.files[0]);\n  }\n  if (upPath && String(upPath).startsWith('/')) {\n    refFileObj = { path: String(upPath), url: 'https://' + sp + '/gradio_api/file=' + String(upPath),\n      orig_name: 'luisa_ref.mp3', mime_type: 'audio/mpeg', size: null, is_stream: false,\n      meta: { _type: 'gradio.FileData' } };\n  }\n} catch (e) {}\nif (!refFileObj) throw new Error('Luisa reference upload path missing');\n\nconst chatterboxWav = async (text) => {\n  const callResp = await T(this.helpers.httpRequest({\n    method: 'POST', url: 'https://' + sp + '/gradio_api/call/generate_tts_audio',\n    headers: { 'Content-Type': 'application/json', ...HF_AUTH },\n    body: JSON.stringify({ data: [text, 'de', refFileObj, 0.72, 0.8, 42, 0.05] }),\n    timeout: 8000 }), 15000);\n  const callObj = typeof callResp === 'string' ? JSON.parse(callResp) : callResp;\n  if (!callObj || !callObj.event_id) return null;\n  const sseText = await T(this.helpers.httpRequest({\n    method: 'GET', url: 'https://' + sp + '/gradio_api/call/generate_tts_audio/' + callObj.event_id,\n    headers: HF_AUTH, timeout: 60000 }), 90000);\n  if (!sseText) return null;\n  for (const line of String(sseText).split('\\n')) {\n    if (line.startsWith('data: ') && line.trim() !== 'data: null') {\n      const d = JSON.parse(line.slice(6));\n      if (Array.isArray(d) && d[0] && d[0].url) {\n        const wavBuf = Buffer.from(await T(this.helpers.httpRequest({\n          method: 'GET', url: d[0].url, headers: HF_AUTH, encoding: 'arraybuffer', timeout: 15000 }), 20000));\n        if (wavBuf && wavBuf.length > 44 && wavBuf.length < 2000000) return wavBuf;\n      }\n    }\n  }\n  return null;\n};\n\nconst items = [];\nfor (const scene of spec.scenes) {\n  if (scene.video_url || scene.audio_url) {\n    items.push({ json: { scene, kind: 'ready' } });\n    continue;\n  }\n  const wav = await chatterboxWav(scene.text);\n  if (!wav) throw new Error('Chatterbox TTS failed for scene ' + scene.id + ' - aborting, no silent audio');\n  const bin = await this.helpers.prepareBinaryData(wav, scene.id + '.wav', 'audio/wav');\n  items.push({ json: { scene, kind: scene.kind }, binary: { voice: bin } });\n}\nreturn items;"
      }
    },
