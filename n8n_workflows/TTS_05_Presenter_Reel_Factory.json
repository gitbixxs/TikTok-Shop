        "jsCode": "const scene = $('Parse LongCat Result').item.json.scene;\nconst raw = $input.item.json;\nconst catbox = typeof raw === 'string' ? raw : (raw && (raw.data || raw.result)) || '';\nreturn { json: { scene_id: scene.id, kind: 'video', video_url: $('Store Clip MP4').item.json.file_url, catbox_url: String(catbox), scene } };"
