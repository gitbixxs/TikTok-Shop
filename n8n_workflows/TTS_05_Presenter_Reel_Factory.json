    {
      "id": "59fe7eed-0139-4da7-8dff-159619055a41",
      "name": "Prepare Zernio Draft Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6496,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const spec = $('Assemble Render Spec').first()?.json || {};\nconst presign = $('Zernio Presign Video').first()?.json || {};\nconst reelUrl = String(presign.publicUrl || presign.url || '');\nconst zernioBody = {\n  content: String(spec.caption_de || ''),\n  publishNow: true,\n  platforms: [{ platform: 'tiktok', accountId: '6a99599b77555aae01ce4ec4' }],\n  mediaItems: reelUrl ? [{ type: 'video', url: reelUrl }] : [],\n  tiktokSettings: {\n    draft: true,\n    is_ai_generated: true,\n    privacy_level: 'PUBLIC_TO_EVERYONE',\n    allow_comment: true,\n    allow_duet: true,\n    allow_stitch: true,\n    content_preview_confirmed: true,\n    express_consent_given: true\n  }\n};\nreturn [{ json: { ...spec, final_video_url: reelUrl, zernio_body: JSON.stringify(zernioBody) } }];"
      }
    },
    {
      "id": "2b1eb16d-8fba-483c-94f4-c0990345e230",
      "name": "Zernio TikTok Draft API (@bizpunk72)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        6720,
