    {
      "id": "6362db67-a722-4235-8f46-f994beff4f9d",
      "name": "Validate Draft Receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6944,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const prev = $('Prepare Zernio Draft Payload').first()?.json || {};\nconst zResp = $input.first()?.json || {};\nconst postObj = zResp.post || zResp.data?.post || zResp.data || {};\nif (zResp.error || !postObj._id) throw new Error('Zernio draft creation failed or returned no post ID');\nconst platform = (Array.isArray(postObj.platforms) ? postObj.platforms : []).find(p => p.platform === 'tiktok' && p.status === 'published' && String(p.platformPostId || '').startsWith('v_inbox_url') && p.platformSpecificData?.isDraft === true && p.platformSpecificData?.tiktokSettings?.draft === true && p.platformSpecificData?.tiktokSettings?.is_ai_generated === true);\nif (!platform) throw new Error('Zernio response does not confirm an AI-disclosed TikTok Creator Inbox draft');\nreturn [{ json: { ...prev, zernio_post_id: String(postObj._id), publish_status: 'draft_in_inbox' } }];"
      }
    },
    {
      "id": "fd0df11a-d799-435f-9058-af7b5de14378",
      "name": "Build LongCat Payloads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3760,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ups = $('Upload To LongCat').all();\nconst mias = $('Attach Scene And Mia').all();\nconst items = [];\nfor (let i = 0; i < mias.length; i++) {\n  const img = ups[i * 2].json;\n  const wav = ups[i * 2 + 1].json;\n  const scene = mias[i].json.scene;\n  const body = JSON.stringify({ data: [\n    { path: img, meta: { _type: 'gradio.FileData' } },\n    { path: wav, meta: { _type: 'gradio.FileData' } },\n    scene.prompt, '480p', 72, 'Clean speech (fast)', 'Exact 8-step'\n  ]});\n  items.push({ json: { scene, submit_body: body } });\n}\nreturn items;"
      }
    },
